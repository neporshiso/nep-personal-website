# Environment variables read by this app (src/lib/nanban/env.ts).
#
# This is a TEMPLATE. It is committed to a PUBLIC repo, so it must never
# contain a real value — names and descriptions only.
#
# Vercel is the only secret store. To get a working .env.local locally:
#
#     vercel env pull .env.local
#
# .env.local is gitignored. Do not add values to this file.

# --- Nanban auth (src/lib/nanban/auth.ts) ---
# Shared password checked at the /nanban login form.
NANBAN_PASSWORD=
# HMAC-SHA256 key used to sign and verify the /nanban session cookie.
NANBAN_COOKIE_SECRET=

# --- Upstash Redis, the Nanban board store (src/lib/nanban/redis.ts) ---
# Base URL of the Upstash Redis REST endpoint.
UPSTASH_REDIS_REST_URL=
# Bearer token for that REST endpoint.
UPSTASH_REDIS_REST_TOKEN=

# --- Basecamp API (src/lib/nanban/basecamp.ts) ---
# Basecamp account id; forms the API base https://3.basecampapi.com/<id>.
BASECAMP_ACCOUNT_ID=
# OAuth client id for the 37signals integration.
BASECAMP_CLIENT_ID=
# OAuth client secret for that integration.
BASECAMP_CLIENT_SECRET=
# OAuth redirect URI registered with 37signals; must match exactly.
BASECAMP_REDIRECT_URI=
